# ==============================================================================
# SignalForge Environment Configuration
# ==============================================================================

# Database: MongoDB Connection String (Server-only)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/signalforge?retryWrites=true&w=majority"

# Authentication: Session Secret (Server-only)
AUTH_SECRET="your-32-byte-hex-auth-secret-key-here"

# Public App URL (Client & Server)
NEXT_PUBLIC_APP_URL="https://signalforge.dev"

# Cloudinary Asset Engine (Server-only API secret; Cloud name and key used for uploads)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# AI Inference Engine: @google/genai (Server-only)
AI_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=

# NVIDIA API Integration
NVIDIA_API_KEY=
NVIDIA_IMAGE_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b
NVIDIA_IMAGE_MODEL=qwen/qwen-image
AI_PROVIDER=gemini

# LinkedIn Professional Integration (Server-only)
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"

# X (Twitter) Developer API (Server-only)
X_CLIENT_ID="your-x-client-id"
X_CLIENT_SECRET="your-x-client-secret"

# System Security & Telemetry (Server-only)
CRON_SECRET="your-cron-secret-token"
ENCRYPTION_KEY="your-32-byte-encryption-key-for-oauth-tokens"
