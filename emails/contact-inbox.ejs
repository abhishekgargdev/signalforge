<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
  <tr>
    <td style="padding:10px 0;width:120px;color:#94a3b8;vertical-align:top;border-bottom:1px solid #1f2937;">Name</td>
    <td style="padding:10px 0;color:#f8fafc;border-bottom:1px solid #1f2937;"><%= name %></td>
  </tr>
  <tr>
    <td style="padding:10px 0;width:120px;color:#94a3b8;vertical-align:top;border-bottom:1px solid #1f2937;">Email</td>
    <td style="padding:10px 0;color:#f8fafc;border-bottom:1px solid #1f2937;">
      <a href="mailto:<%= email %>" style="color:#22c55e;text-decoration:none;"><%= email %></a>
    </td>
  </tr>
  <tr>
    <td style="padding:10px 0;width:120px;color:#94a3b8;vertical-align:top;">Message</td>
    <td style="padding:10px 0;color:#f8fafc;white-space:pre-wrap;"><%= message %></td>
  </tr>
</table>
