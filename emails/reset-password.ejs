<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
  <tr>
    <td style="padding:0 0 16px;color:#e2e8f0;font-size:14px;line-height:1.6;">
      A password reset was requested for <%= email %>. This link expires in one hour.
    </td>
  </tr>
  <tr>
    <td style="padding:8px 0 18px;">
      <a href="<%= resetUrl %>" style="display:inline-block;background:#22c55e;color:#052e16;text-decoration:none;font-weight:700;padding:10px 16px;border-radius:8px;">Choose a new password</a>
    </td>
  </tr>
  <tr>
    <td style="padding:8px 0;color:#94a3b8;font-size:12px;line-height:1.5;">
      If the button does not open, copy this link into your browser:<br />
      <span style="color:#e2e8f0;word-break:break-all;"><%= resetUrl %></span>
    </td>
  </tr>
  <tr>
    <td style="padding:12px 0 0;color:#94a3b8;font-size:12px;">
      If you did not ask for this, you can ignore the message. Your password will stay the same.
    </td>
  </tr>
</table>
