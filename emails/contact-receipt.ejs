<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
  <tr>
    <td style="padding:0 0 16px;color:#e2e8f0;font-size:14px;line-height:1.6;">
      Hello <%= name %>, we received your note and will reply to <%= email %>.
    </td>
  </tr>
  <tr>
    <td style="padding:12px;background:#080c08;border:1px solid #1f2937;border-radius:8px;color:#cbd5e1;white-space:pre-wrap;"><%= message %></td>
  </tr>
</table>
